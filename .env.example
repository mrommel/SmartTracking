# SmartTracking environment variables.
# Copy this file to `.env` (which is gitignored) and adjust values.
# `make run` auto-loads `.env` before starting the dev server + MCP server.

# ---------------------------------------------------------------------------
# Django settings (production overrides — picked up by setup/settings/prod.py)
# ---------------------------------------------------------------------------

# Required in production; change to a random secret key.
SECRET_KEY=change-me-to-a-random-token

# Set to True only during development.
DEBUG=False

# Comma-separated list of allowed hostnames.
ALLOWED_HOSTS=example.com,www.example.com

# Database URL — SQLite default works for local prod; swap for PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Email backend — switch to smtp.EmailBackend and configure SMTP for real mail.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Optional Sentry DSN for error monitoring.  When set, security headers
# (HSTS, secure cookies, SSL redirect) are enabled automatically.
DJANGO_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Existing vars (keep these)
# ---------------------------------------------------------------------------

# Shared bearer token for the JSON REST API (tracking/api.py).
# Clients authenticate with: Authorization: Bearer <token>
# Also used by the bundled MCP server (mcp_server.py) to call the REST API.
# Leave empty to disable token auth (API then only accepts logged-in sessions).
TRACKING_API_TOKEN=change-me-to-a-random-token

# MCP server (started by `make run`, see mcp_server.md). Defaults shown.
# SMARTTRACKING_URL=http://127.0.0.1:8092
# MCP_HOST=127.0.0.1
# MCP_PORT=8091

# Upstream (Django REST API) request timeout in seconds, used by the MCP server.
# Keep it low: a stalled upstream must never hold a tool call open long enough
# for the editor client to give up on the whole MCP session.
# TRACKING_HTTP_TIMEOUT=15

